# ============================================================
# ERP Docker Compose 环境变量模板
# 使用：cp .env.example .env  然后按需修改
# 说明：.env 已被 .gitignore 忽略，不会提交到版本库
# ============================================================

# ---------- MySQL 数据库 ----------
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=erp_password
MYSQL_DATABASE=erp_db
MYSQL_PORT=3306

# ---------- 后端 API ----------
BACKEND_PORT=8080
# Development 会启用 Swagger（演示用）；生产请改为 Production
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET_KEY=docker-demo-jwt-secret-key-change-me-32bytes-01
JWT_ISSUER=erp.demo
JWT_AUDIENCE=erp.web
JWT_EXPIRES_MINUTES=480
LOGIN_PEPPER=erp-pepper
PAY_SECRET=erp-pay-secret

# ---------- 前端 ----------
FRONTEND_PORT=5173

# ---------- 可选组件（docker-compose.full.yml 使用） ----------
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
